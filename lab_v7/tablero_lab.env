# ==============================================================================
# NEXUS LAB-V7 — TABLERO DE CONTROL (único lugar donde se tocan los interruptores)
# Lo leen: correr_tablero.sh (que lo carga y lanza Fase 3 lab, Fase 4 lab, 4.5 A y 4.5 B).
# Valores actuales = configuración del CRO: lab V7 completo, tamaño A, Vida v3.
# ==============================================================================
# --- ALCANCE (Fases 3, 4 y 4.5) ------------------------------------------------
# SIMBOLOS: lista separada por comas. Vacío = los 28 símbolos. Con recursos escasos: empezar por uno (ej. EURUSDm).
NEXUS_LAB_SIMBOLOS=
# --- FASE 3 lab ---------------------------------------------------------------
# N_SIM: trials COMPLETOS por (fold, dirección). Vacío = 20000 (valor de Fase_3.py). Es lo que más cuesta.
NEXUS_LAB_N_SIM=
# STARTUP: trials aleatorios iniciales del TPE. Vacío = 5000. Debe ser menor que N_SIM.
NEXUS_LAB_STARTUP=
# METRICA: con qué métrica busca/selecciona (también en Fases 4 y 4.5).  final | v7
NEXUS_LAB_METRICA=v7
# F3_MEDIR: 0 = corrida completa. N>0 = solo mide tiempo con N trials (1 símbolo, 1 fold, sin CSV).
NEXUS_LAB_F3_MEDIR=0
# --- FASE 4 lab / 4.5 -----------------------------------------------------------
# F3: qué CSV de Fase 3 lee Fase 4.  main (CSV de siempre) | v7 (CSV _MV7 de Fase 3 lab)
NEXUS_LAB_F3=v7
# CIERRE: qué aprende el Ridge 2 (supervivencia).  T_terminal | dT_cont | G_pips | V3 (Vida v3, 5 descriptores)
NEXUS_LAB_CIERRE=V3
# TAMANO: escala opcional de v_req.  off | A (Ridge extra que predice MFE_Pips) | B (fórmula de actividad, sin Ridge)
NEXUS_LAB_TAMANO=A
# NULO: gemelo nulo de diagnóstico (NO exportable; no usar con TAMANO=A/B).  0 | 1
NEXUS_LAB_NULO=0
# --- GEOMETRÍA (compartida por Fases 3, 4 y 4.5; NO va aquí) ---------------------
# N_FOLDS, RATIO_TRAIN_TEST, RESERVA_FINAL y MEMORIA_FIFO viven en nexus_tablero.py (raíz del repo). Hoy: 2 folds, ratio 2.0,
# reserva ciega 0.25, FIFO 100. Cambiarlos invalida los CSV previos (el sello lo detecta). correr_tablero.sh los imprime al arrancar.
